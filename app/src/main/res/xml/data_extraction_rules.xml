<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for API 31+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Legacy plaintext auth prefs — never back up. -->
        <exclude domain="sharedpref" path="folio_auth_session.xml" />
        <!-- Encrypted auth DataStore — Keystore keys do not restore across devices. -->
        <exclude domain="file" path="datastore/folio_auth_session_encrypted.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="folio_auth_session.xml" />
        <exclude domain="file" path="datastore/folio_auth_session_encrypted.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
